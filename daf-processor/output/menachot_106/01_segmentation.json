  "amud": "a",
  "macro_segments": [
    {
      "title": "The Case of Vowing a Mincha of Isaron with Uncertainty About Quantity",
      "display_title": "Mincha Vow Uncertainty",
      "timestamp": "00:00",
      "micro_segments": [
        {
          "title": "Mishna: Designating a singular mincha of isaron",
          "display_title": "Designating Mincha",
          "timestamp": "00:00"
        },
        {
          "title": "The dispute between Chachamim and Rabbi: bringing sixty versus bringing 1-60",
          "display_title": "Chachamim vs. Rabbi",
          "timestamp": "00:42"
        },
        {
          "title": "Mathematical calculation of the sum 1+2+...+60 using the Tosafot method",
          "display_title": "Sum 1-60: 1830",
          "timestamp": "01:46"
        },
        {
          "title": "The core debate: Whether mixing obligatory with voluntary is permitted",
          "display_title": "Obligation/Voluntary Mix",
          "timestamp": "04:54"
        }
      ]
    },
    {
      "title": "The Problem of Mixing Obligatory and Voluntary with Two Kematzim",
      "display_title": "Two Kematzim Issue",
      "timestamp": "09:12",
      "micro_segments": [
        {
          "title": "Abaye's challenge: if chova and nedava are mixed, two kematzim are needed",
          "display_title": "Abaye: Two Kematzim",
          "timestamp": "09:12"
        },
        {
          "title": "The problem of which kematz to offer first and contamination of shirayim",
          "display_title": "Kematz Order Problem",
          "timestamp": "10:48"
        },
        {
          "title": "Solution: assign portions to the kohen's hand and the intent of the vow",
          "display_title": "Kohen's Hand Solution",
          "timestamp": "10:52"
        },
        {
          "title": "The issue of whether the second kematz is truly a valid offering or just firewood",
          "display_title": "Second Kematz Status",
          "timestamp": "12:27"
        },
        {
          "title": "Rav Yehuda's answer: treat doubtful kematz as firewood, not as an offering",
          "display_title": "Firewood Solution",
          "timestamp": "15:07"
        }
      ]
    },
    {
      "title": "Alternative Explanations of the Debate: Mixing Permission and Rabbi Eliezer",
      "display_title": "Alternative Theories",
      "timestamp": "16:32",
      "micro_segments": [
        {
          "title": "Rav Acha's proposal: maybe the debate is about whether mixing is permitted at all",
          "display_title": "Rav Acha Theory",
          "timestamp": "16:32"
        },
        {
          "title": "Rava's resolution: both agree mixing is allowed; the debate is about Rabbi Eliezer's oil rule",
          "display_title": "Rava: Oil Proportion",
          "timestamp": "19:36"
        },
        {
          "title": "The source of the debate: Rabbi Eliezer ben Yaakov says one log for any mincha size",
          "display_title": "Rabbi Eliezer Rule",
          "timestamp": "20:00"
        },
        {
          "title": "Practical consequence: uncertainty about number of menachot means uncertain oil amounts",
          "display_title": "Oil Uncertainty",
          "timestamp": "20:43"
        }
      ]
    },
    {
      "title": "Alternative Theory: Exact Amount vs. Minimum Amount in Vows",
      "display_title": "Exact vs. Minimum",
      "timestamp": "22:05",
      "micro_segments": [
        {
          "title": "Rav Ashi's alternative: the debate may concern whether a vowed amount is exact or minimum",
          "display_title": "Rav Ashi Theory",
          "timestamp": "22:05"
        },
        {
          "title": "Chachamim: small animal plus big animal satisfies vow (minimum interpretation)",
          "display_title": "Small/Big Animal",
          "timestamp": "22:59"
        },
        {
          "title": "Rabbi: small plus big does not satisfy (exact interpretation required)",
          "display_title": "Exact Amount Only",
          "timestamp": "23:12"
        },
        {
          "title": "Why this matters for mincha: if exact, cannot mix; if minimum, can mix with stipulation",
          "display_title": "Implication for Mincha",
          "timestamp": "23:35"
        }
      ]
    },
    {
      "title": "Vows of Wood, Frankincense, Metals, and Other Dedicated Items",
      "display_title": "Non-Grain Vows",
      "timestamp": "26:24",
      "micro_segments": [
        {
          "title": "Mishna: vowing wood—minimum is two logs",
          "display_title": "Wood Vow: 2 Logs",
          "timestamp": "26:24"
        },
        {
          "title": "Gold: not less than one gold dinar coin",
          "display_title": "Gold Dinar",
          "timestamp": "28:02"
        },
        {
          "title": "Silver: not less than one silver dinar coin",
          "display_title": "Silver Dinar",
          "timestamp": "28:07"
        },
        {
          "title": "Copper: not less than a silver ma'ah of value",
          "display_title": "Copper Value",
          "timestamp": "28:14"
        },
        {
          "title": "Gemara: learning that wood can be dedicated as a korban from Nehemiah",
          "display_title": "Wood as Korban",
          "timestamp": "29:38"
        },
        {
          "title": "Rabbi's position: wood requires salt, hagasha, and possibly kemitza",
          "display_title": "Rabbi on Wood",
          "timestamp": "30:33"
        },
        {
          "title": "Frankincense: minimum is one kometz, equated to the kometz of mincha",
          "display_title": "Frankincense Kometz",
          "timestamp": "31:51"
        }
      ]
    },
    {
      "title": "The Default Offering When 'Altar' is Vowed Without Specification",
      "display_title": "Altar Default Item",
      "timestamp": "33:18",
      "micro_segments": [
        {
          "title": "Mishna: vowing 'to the altar' without specification means frankincense",
          "display_title": "Default: Frankincense",
          "timestamp": "33:18"
        },
        {
          "title": "Gemara: why not olah? Because the skin goes to the kohanim",
          "display_title": "Not Olah",
          "timestamp": "34:09"
        },
        {
          "title": "Why not bird olah? Feathers and organs don't go to the altar",
          "display_title": "Not Bird Olah",
          "timestamp": "34:23"
        },
        {
          "title": "Why not nesachim (libations)? Poured into funnels, not burnt on altar",
          "display_title": "Not Libations",
          "timestamp": "34:38"
        },
        {
          "title": "Why not minchat nesachim? Because standard mincha is eaten by kohanim",
          "display_title": "Not Mincha Type",
          "timestamp": "34:54"
        },
        {
          "title": "Frankincense is the exclusive item fully burnt on the altar, hence the default",
          "display_title": "Frankincense Unique",
          "timestamp": "34:59"
        }
      ]
    },
    {
      "title": "Vowing Without Specifying Type: Metals and Their Minimum Amounts",
      "display_title": "Metal Vow Details",
      "timestamp": "36:34",
      "micro_segments": [
        {
          "title": "Mishna: vowing 'gold' uncertainly and its minimum standard",
          "display_title": "Gold Minimum",
          "timestamp": "36:34"
        },
        {
          "title": "Debate whether 'gold' means a coin or an ingot; Rabbi Elazar says coin",
          "display_title": "Gold Coin Standard",
          "timestamp": "36:45"
        },
        {
          "title": "Gold small change does not exist; therefore coin is standard",
          "display_title": "No Gold Pennies",
          "timestamp": "37:07"
        },
        {
          "title": "Silver: one silver dinar, with uncertainty about ingots and small change",
          "display_title": "Silver Standard",
          "timestamp": "37:18"
        },
        {
          "title": "Rav Sheshes: silver small change context-dependent on local usage",
          "display_title": "Silver Small Change",
          "timestamp": "37:35"
        },
        {
          "title": "Copper: not less than a ma'ah of silver value; alternative—a small copper fork",
          "display_title": "Copper Minimum",
          "timestamp": "37:59"
        },
        {
          "title": "Abaye: the copper fork is used for cleaning lamps and wicks",
          "display_title": "Copper Fork Use",
          "timestamp": "38:20"
        },
        {
          "title": "Iron: minimum is the amount needed for a raven-spike on the Temple roof",
          "display_title": "Iron Spike",
