{
  "name": "italmud-demo-video",
  "private": true,
  "type": "module",
  "scripts": {
    "capture": "node capture/capture.mjs",
    "studio": "remotion studio src/index.ts",
    "render:wide": "remotion render src/index.ts Demo16x9 out/italmud-demo-16x9.mp4",
    "render:tall": "remotion render src/index.ts Demo9x16 out/italmud-demo-9x16.mp4",
    "capture90": "node capture/scenes90.mjs",
    "render90:wide": "remotion render src/index.ts Demo90-16x9 out/italmud-demo-90s-16x9.mp4",
    "render90:tall": "remotion render src/index.ts Demo90-9x16 out/italmud-demo-90s-9x16.mp4",
    "render90v:wide": "remotion render src/index.ts Demo90v-16x9 out/italmud-demo-90s-voice-16x9.mp4",
    "beats": "node capture/beats.mjs && node capture/collect.mjs",
    "rendercalm": "node tools/render.mjs --silent",
    "rendercalmv": "node tools/render.mjs",
    "render90v:tall": "remotion render src/index.ts Demo90v-9x16 out/italmud-demo-90s-voice-9x16.mp4",
    "chapters": "node tools/chapters.mjs"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.547",
    "@types/react": "^18.3.12",
    "playwright": "^1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.547",
    "typescript": "^5.6.3"
  }
}
